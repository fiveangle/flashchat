{
  "schema": 1,
  "id": "qwen3-coder-next",
  "name": "Qwen3-Coder-Next",
  "hf_repo": "Qwen/Qwen3-Coder-Next",
  "source_format": "native_bf16",
  "default_variant": "q4",
  "architecture": {
    "hidden_size": 2048,
    "num_hidden_layers": 48,
    "num_attention_heads": 16,
    "num_key_value_heads": 2,
    "head_dim": 256,
    "vocab_size": 151936,
    "rms_norm_eps": 1e-06,
    "num_experts": 512,
    "num_experts_per_tok": 10,
    "moe_intermediate_size": 512,
    "shared_expert_intermediate_size": 512,
    "full_attention_interval": 4,
    "max_context": 262144,
    "linear_num_value_heads": 32,
    "linear_num_key_heads": 16,
    "linear_key_head_dim": 128,
    "linear_value_head_dim": 128,
    "linear_conv_kernel_dim": 4,
    "partial_rotary_factor": 0.25,
    "rope_theta": 5000000
  },
  "special_tokens": {
    "eos_1": 151645,
    "eos_2": 151643,
    "think_start": 151667,
    "think_end": 151668
  },
  "default_sampling_profile": "instruct",
  "sampling_profiles": {
    "instruct": {
      "label": "Instruct (non-thinking)",
      "description": "Qwen's recommended settings for agentic coding.",
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 40,
      "min_p": 0.0,
      "presence_penalty": 0.0,
      "repetition_penalty": 1.0,
      "reasoning": 0
    }
  },
  "shared_artifacts": {
    "vocab.bin": {
      "step": "export_tokenizer"
    }
  },
  "variants": {
    "q4": {
      "quantization": {
        "bits": 4,
        "group_size": 64
      },
      "artifacts": {
        "model_weights.bin": {
          "step": "compile_native:non_experts",
          "companions": [
            "model_weights.json"
          ]
        },
        "packed_experts/": {
          "step": "compile_native:experts",
          "per_layer": "moe_layers",
          "layout": "layout.json"
        },
        "packed_mtp_experts/": {
          "step": "compile_native:mtp_experts",
          "per_layer": "mtp_layers",
          "layout": "layout.json",
          "required_if": "mtp"
        },
        "vocab.bin": {
          "from_shared": "vocab.bin"
        }
      }
    },
    "q8": {
      "quantization": {
        "bits": 8,
        "group_size": 64
      },
      "artifacts": {
        "model_weights.bin": {
          "step": "compile_native:non_experts",
          "companions": [
            "model_weights.json"
          ]
        },
        "packed_experts/": {
          "step": "compile_native:experts",
          "per_layer": "moe_layers",
          "layout": "layout.json"
        },
        "packed_mtp_experts/": {
          "step": "compile_native:mtp_experts",
          "per_layer": "mtp_layers",
          "layout": "layout.json",
          "required_if": "mtp"
        },
        "vocab.bin": {
          "from_shared": "vocab.bin"
        }
      }
    }
  },
  "thinking_capable": false
}
